---
import ProjectDet from "../../projectDet.astro";

import AniSS1 from "/src/assets/hero.png";
import AniSS2 from "/src/assets/hero 2.png";
import AniSS3 from "/src/assets/Catalogo.png";
import AniSS4 from "/src/assets/watch.png";
import AniSS5 from "/src/assets/details.png";
---

<ProjectDet
  title="Ani Web App"
  tech="Desarrollo Full-Stack | Diseño UI/UX"
  descript1="Astro 5 · TypeScript · Tailwind CSS · Cheerio · SSR"
  descript2="Ani Web App es una plataforma web de anime que combina un catálogo dinámico con una experiencia de navegación y reproducción adaptable a distintos dispositivos. Permite explorar títulos, consultar detalles, acceder a episodios y cambiar entre servidores de video disponibles. También incorpora una lista personal y seguimiento del progreso de visualización, almacenando los datos localmente para que los usuarios puedan retomar sus episodios sin necesidad de crear una cuenta."
  link="https://ani-web-coral.vercel.app/"
  imageSources={[
    { src: AniSS1, title: "Sección principal" },
    { src: AniSS2, title: "Recomendaciones de contenido" },
    { src: AniSS3, title: "Catálogo de anime" },
    { src: AniSS5, title: "Detalles del contenido" },
    { src: AniSS4, title: "Reproductor y selección de servidores" },
  ]}
  insight={{
    title: "Implementación técnica",
    heading: "Del diseño de interfaz a una aplicación funcional",
    description:
      "El proyecto evolucionó de una propuesta de diseño UI/UX a una aplicación web funcional. Astro se utiliza para renderizar las páginas desde el servidor, mientras que Cheerio permite extraer y procesar información de fuentes externas. Se implementó una caché en memoria para reducir solicitudes repetidas y mejorar la eficiencia al consultar contenido reciente. En el cliente, localStorage permite guardar títulos y conservar el progreso de los episodios sin depender de cuentas de usuario ni de una base de datos. La interfaz se construyó con Tailwind CSS, manteniendo una estructura basada en componentes y adaptable a distintos tamaños de pantalla.",
  }}
/>
