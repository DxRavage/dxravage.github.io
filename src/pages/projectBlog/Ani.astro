---
import ProjectDet from "../projectDet.astro";

import AniSS1 from "/src/assets/hero.png";
import AniSS2 from "/src/assets/hero 2.png";
import AniSS3 from "/src/assets/Catalogo.png";
import AniSS4 from "/src/assets/watch.png";
import AniSS5 from "/src/assets/details.png";
---

<ProjectDet
  title="Ani Web App"
  tech="Full-Stack Development | UX/UI Design"
  descript1="Astro 5 · TypeScript · Tailwind · Cheerio · SSR"
  descript2="An anime catalog and streaming web app built with Astro. It combines dynamically retrieved anime data with a responsive interface for browsing titles, viewing episodes, and switching between available video servers. The app also includes a personal watchlist and episode progress tracking, with viewing data stored locally so users can pick up where they left off."
  link="https://ani-web-coral.vercel.app/"
  imageSources={[
    { src: AniSS1, title: "Hero Section" },
    { src: AniSS2, title: "Content Recommendations" },
    { src: AniSS3, title: "Anime Catalog" },
    { src: AniSS5, title: "Content Details" },
    { src: AniSS4, title: "Video Player & Streaming" },
  ]}
  insight={{
    title: "Technical Implementation",
    heading: "Connecting Content Discovery with Playback",
    description:
      "The app uses Astro's server-side rendering to retrieve and present catalog data, with Cheerio handling HTML parsing from external sources. An in-memory cache helps avoid repeating requests for recently accessed content. On the client side, localStorage keeps track of episode progress and saved titles without requiring user accounts or a separate database. The interface is built with Tailwind CSS and adapts to different screen sizes, with dedicated views for browsing anime and watching episodes.",
  }}
/>
